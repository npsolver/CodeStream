# Multi-stage build for api-service (optional — EC2 deploy uses JAR + systemd by default).
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml .
COPY common common
COPY api-service api-service
RUN mvn -pl api-service -am package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/api-service/target/api-service-*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]

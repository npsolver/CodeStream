# Vercel project environment variables (Settings → Environment Variables).
# Redeploy after changing — rewrites are baked in at build time.

API_SERVICE_URL=https://api.codestream.npsolver.io

# Browser requests go to /api/* on your Vercel domain; Next.js rewrites proxy them
# to API_SERVICE_URL. CORS on the EC2 API is not required for this setup.
#
# Alternative (direct browser → API, requires CORS on EC2):
# NEXT_PUBLIC_API_BASE_URL=https://api.codestream.npsolver.io
